{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private authenticated user profile isolated to the owning user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 255,
          "description": "User email address (PII, restricted to owner)."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "EmailLookup": {
      "title": "EmailLookup",
      "description": "Non-PII SHA-256 email hash directory entry enabling task sharing by exact email without exposing user emails.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID mapped to the hashed email."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the target user."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A shared to-do task owned by a user and optionally shared with up to 20 collaborators.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Task title."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Optional task description."
        },
        "completed": {
          "type": "boolean",
          "description": "Completion status of the task."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the task creator."
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the task creator."
        },
        "sharedWithUids": {
          "type": "array",
          "description": "Bounded list (max 20) of collaborator UIDs with access to this task."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "title",
        "description",
        "completed",
        "ownerId",
        "ownerName",
        "sharedWithUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskShare": {
      "title": "TaskShare",
      "description": "Collaborator access metadata for a shared task.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the collaborator granted access."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the collaborator."
        },
        "sharedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who granted the share."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["uid", "displayName", "sharedBy", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user profiles isolated to the authenticated owner."
    },
    "/emailLookup/{emailHash}": {
      "schema": { "$ref": "#/entities/EmailLookup" },
      "description": "SHA-256 email-hash lookup documents for resolving share recipients without exposing PII."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks owned by or shared with authenticated users."
    },
    "/tasks/{taskId}/shares/{shareUserId}": {
      "schema": { "$ref": "#/entities/TaskShare" },
      "description": "Per-collaborator share records gated by the parent task document."
    }
  }
}
